# 复制为 .env 后按需修改（不要提交 .env）
TL_ENV=dev
TL_DATABASE_URL=postgresql+psycopg://tl:tl@localhost:5432/tradeleads
TL_REDIS_URL=redis://localhost:6379/0
TL_JWT_SECRET=请改成至少32位的随机字符串
TL_ACCESS_TOKEN_MINUTES=120
TL_CORS_ORIGINS=http://localhost:5173

# LLM 网关：mock | qwen | deepseek
TL_LLM_PRIMARY=mock
TL_LLM_FALLBACK=
TL_QWEN_API_KEY=
TL_QWEN_MODEL=qwen-plus
TL_DEEPSEEK_API_KEY=
TL_DEEPSEEK_MODEL=deepseek-chat

# 平台管理员（开通租户）。留空则 HTTP 接口禁用，只能用命令行 python -m app.admin
TL_PLATFORM_ADMIN_TOKEN=

# 官网解析
TL_CRAWL_MAX_PAGES=30
TL_CRAWL_ALLOW_PRIVATE=false

# 导入文件目录（backend 与 worker 需共享）
TL_UPLOAD_DIR=/tmp/tuoyu-uploads

# 联系人数据源：mock | apollo | hunter | snov（真实数据源待提供 Key 后接入）
TL_CONTACT_PROVIDER=mock
TL_APOLLO_API_KEY=
TL_HUNTER_API_KEY=
TL_SNOV_CLIENT_ID=
TL_SNOV_CLIENT_SECRET=

# ---- P2：数据源 / 邮箱验证 / 合规 ----
# 联系人数据源：auto = 配置了 HUNTER_API_KEY 用 Hunter，否则 mock
TL_CONTACT_PROVIDER=auto
HUNTER_API_KEY=
# 邮箱验证：auto = 有 MillionVerifier Key 用它，否则有 Hunter Key 用 Hunter，否则 mock
TL_VERIFIER_PROVIDER=auto
MILLIONVERIFIER_API_KEY=
TL_VERIFY_CHECK_MX=true
# 退订链接对外域名（邮件里的退订链接用这个）
TL_PUBLIC_BASE_URL=http://localhost:8000
TL_UNSUBSCRIBE_SECRET=change-me-unsub
# 制裁名单（公开数据，无需 Key）；每日 10:30 UTC 由 Celery beat 自动更新
TL_SANCTIONS_THRESHOLD=0.85

# ---- P3 发件箱 / 序列 ----
# 发件箱凭据加密密钥（Fernet，可逗号分隔多把用于轮换）。生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TL_CREDENTIALS_KEY=
# 安全护栏：false 时只允许连接本地测试邮件服务器（下方白名单），绝不外发真实邮件
TL_OUTBOUND_ALLOW_REAL=false
TL_OUTBOUND_SINK_HOSTS=localhost,127.0.0.1,::1,mailpit,mailhog
# 可选：UDP DNS 受限环境下用 DNS-over-HTTPS 做 DNS 体检
TL_DNS_DOH_URL=
