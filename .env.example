# 复制为 .env 后按需修改（不要提交 .env）
TL_ENV=dev
TL_DATABASE_URL=postgresql+psycopg://tl:tl@localhost:5432/tradeleads
TL_REDIS_URL=redis://localhost:6379/0
TL_JWT_SECRET=请改成至少32位的随机字符串
TL_ACCESS_TOKEN_MINUTES=120
TL_CORS_ORIGINS=http://localhost:5173

# LLM 网关：mock | qwen | deepseek
TL_LLM_PRIMARY=mock
TL_LLM_FALLBACK=
TL_QWEN_API_KEY=
TL_QWEN_MODEL=qwen-plus
TL_DEEPSEEK_API_KEY=
TL_DEEPSEEK_MODEL=deepseek-chat

# 平台管理员（开通租户）。留空则 HTTP 接口禁用，只能用命令行 python -m app.admin
TL_PLATFORM_ADMIN_TOKEN=

# 官网解析
TL_CRAWL_MAX_PAGES=30
TL_CRAWL_ALLOW_PRIVATE=false

# 导入文件目录（backend 与 worker 需共享）
TL_UPLOAD_DIR=/tmp/tuoyu-uploads

# 联系人数据源：mock | apollo | hunter | snov（真实数据源待提供 Key 后接入）
TL_CONTACT_PROVIDER=mock
TL_APOLLO_API_KEY=
TL_HUNTER_API_KEY=
TL_SNOV_CLIENT_ID=
TL_SNOV_CLIENT_SECRET=
