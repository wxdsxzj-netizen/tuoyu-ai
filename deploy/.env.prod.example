# ============================================================================
# 拓域 AI 生产环境变量模板。复制为 deploy/.env.prod（权限 600，绝不提交到 Git）。
# 标【必填】的必须修改；运行 deploy/scripts/gen-secrets.sh 生成随机密钥。
# ============================================================================

# ---- 版本与域名 ----
APP_VERSION=2026.10.0
APP_DOMAIN=app.example.com            # 【必填】产品访问域名（DNS A 记录指向服务器公网 IP）
ACME_EMAIL=ops@example.com            # 【必填】Let's Encrypt 证书通知邮箱
TL_PUBLIC_BASE_URL=https://app.example.com   # 【必填】= https://APP_DOMAIN，用于退订链接、报价确认链接
TL_CORS_ORIGINS=https://app.example.com      # 【必填】同上

# ---- 数据库 / Redis（compose 内部使用）----
POSTGRES_USER=tuoyu
POSTGRES_DB=tuoyu
POSTGRES_PASSWORD=                    # 【必填】随机 32 位
REDIS_PASSWORD=                       # 【必填】随机 32 位

# ---- 安全密钥 ----
TL_JWT_SECRET=                        # 【必填】登录令牌签名，≥ 32 位随机。更换会使所有人重新登录
TL_CREDENTIALS_KEY=                   # 【必填】Fernet 密钥，加密发件箱 SMTP/IMAP 密码。丢失 = 已绑定发件箱需重新输入密码
                                      #         轮换：新钥在前、旧钥在后，逗号分隔：新,旧
TL_UNSUBSCRIBE_SECRET=                # 【必填】退订链接签名。更换后已发出邮件里的旧退订链接失效（法律风险），上线后不要改
TL_PLATFORM_ADMIN_TOKEN=              # 建议填：平台管理员 HTTP 接口（开通租户、充值、登记发票）令牌；留空则只能用命令行
TL_METRICS_TOKEN=                     # 可选：/metrics 访问令牌（Caddy 已屏蔽公网 /metrics，内网抓取可不填）
TL_ACCESS_TOKEN_MINUTES=120

# ---- 大模型（翻译、分类、建议回复、Agent 解析、背调文字）----
TL_LLM_PRIMARY=qwen                   # 【必填其一】qwen | deepseek | mock（mock = 不调用真实模型）
TL_LLM_FALLBACK=deepseek              # 主模型失败时的备用；不需要可留空
TL_QWEN_API_KEY=                      # 通义千问 DashScope API Key（https://dashscope.console.aliyun.com）
TL_QWEN_MODEL=qwen-plus
TL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 海外服务器可改 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TL_DEEPSEEK_API_KEY=                  # DeepSeek API Key（https://platform.deepseek.com）
TL_DEEPSEEK_MODEL=deepseek-chat

# ---- 联系人数据 / 邮箱验证 ----
TL_CONTACT_PROVIDER=auto              # auto：有 Hunter Key 用 Hunter，否则 mock
HUNTER_API_KEY=                       # 【建议】Hunter.io API Key（域名搜索、邮箱查找、验证）
TL_VERIFIER_PROVIDER=auto             # auto：MillionVerifier > Hunter > mock
MILLIONVERIFIER_API_KEY=              # 【建议】MillionVerifier API Key（批量邮箱验证）
TL_VERIFY_CHECK_MX=true

# ---- 发信安全护栏 ----
TL_OUTBOUND_ALLOW_REAL=false          # 【上线当天由你确认后才改为 true】false = 只允许发往本地测试服务器，绝不外发
TL_OUTBOUND_SINK_HOSTS=localhost,127.0.0.1,::1,mailpit
TL_PLATFORM_COLD_HARD_CAP=80          # 单发件箱每日冷信硬上限
TL_COMPANY_DAILY_LIMIT=3
TL_DNS_DOH_URL=                       # 服务器 UDP DNS 正常时留空

# ---- 官网解析 / 背调抓取 ----
TL_CRAWL_MAX_PAGES=30
TL_CRAWL_ALLOW_PRIVATE=false          # 生产必须 false（防止抓取内网地址）
TL_CRAWL_USER_AGENT=TuoyuBot/1.0 (+https://app.example.com/bot)

# ---- 点数 / Agent / 询盘评分（默认值即 PRD / 你的决定）----
TL_PILOT_GRANT_CREDITS=0              # 新租户自动发放点数；0 = 只由平台管理员手动充值
# 汇率来源：mock = 内置参考汇率（不访问外网）；ecb = 欧洲央行每日参考汇率（公开数据，只做匿名 GET，不发送用户数据）。生产建议 ecb
TL_FX_PROVIDER=mock
TL_FX_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
# 黑名单（DNSBL）检查：mock = 不查询；dns = 通过 DNS 查询 Spamhaus/Barracuda 等公共黑名单
TL_DNSBL_PROVIDER=mock
# DNSBL 专用递归解析器：启用 compose 的 dnsbl profile 后填 unbound；为空用系统 DNS（公共 DNS 会被 Spamhaus 拒绝）
TL_DNSBL_RESOLVER=
# 在线支付渠道（mock = 本地模拟、不扣款；真实渠道需商户资质，未接入）；解约冷静期天数
TL_PAYMENT_PROVIDER=mock
TL_CLOSURE_GRACE_DAYS=30
# 追踪域名 CNAME 目标；单位经济里 1 点折合人民币
TL_TRACKING_HOST=track.tuoyu.example
TL_CREDIT_PRICE_CNY=0.1
TL_AGENT_OVERRUN_BASIS=high           # 自动暂停参照：high = 预估上限；mid = 预估中位数
TL_AGENT_OVERRUN_RATIO=1.0            # 实际消耗 > 参照 × 比例 时暂停
TL_INQ_W_AUTHENTICITY=0.40            # 询盘评分权重（自动归一化）
TL_INQ_W_CLARITY=0.35
TL_INQ_W_FIT=0.25
TL_INQ_WEBSITE_CHECK=true             # 企业邮箱域名官网核验（试点放宽）
TL_INQ_WEBSITE_BONUS=25               # 官网可访问且与发件公司吻合的加分（仅公司不在数据中枢时）
TL_INQ_D_AUTH_THRESHOLD=40            # 真实性低于该分一律 D 级

# ---- 制裁名单（公开数据，无需 Key）----
TL_SANCTIONS_THRESHOLD=0.85

# ---- 日志 ----
TL_LOG_JSON=true

# ---- B6 数据与渠道（可选）----
# 海关数据：默认 mock；真实源需采购后填 Key，并把 TL_CUSTOMS_PROVIDER=importgenius
TL_CUSTOMS_PROVIDER=mock
TL_CUSTOMS_API_KEY=
# WhatsApp Cloud API：无凭据时走 mock；真实外发还需 TL_OUTBOUND_ALLOW_REAL=true
TL_WHATSAPP_TOKEN=
TL_WHATSAPP_PHONE_NUMBER_ID=
